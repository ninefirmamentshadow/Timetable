<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="4dp"
            android:text="@string/settings_backup_section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp"
            android:text="@string/settings_backup_help" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backup_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_create" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/restore_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/backup_restore" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/export_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_calendar" />

        <TextView
            android:id="@+id/working_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/projected"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/settings_about_section" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notices_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notices_open" />
    </LinearLayout>
</ScrollView>
