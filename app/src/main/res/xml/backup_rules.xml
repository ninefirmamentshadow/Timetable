<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and cloud transfer are both off; see AndroidManifest. This file exists
     so the exclusion is explicit rather than implied. Scheduling data stays on
     the device only. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
